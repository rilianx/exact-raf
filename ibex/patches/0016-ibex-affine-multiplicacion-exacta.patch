diff --git a/src/arithmetic/ibex_ExactMult.h b/src/arithmetic/ibex_ExactMult.h
new file mode 100644
index 0000000..cbf456e
--- /dev/null
+++ b/src/arithmetic/ibex_ExactMult.h
@@ -0,0 +1,151 @@
+/* ============================================================================
+ * I B E X - Exact multiplication of reduced affine forms (fAF2)
+ * ============================================================================
+ * [raak local, parche 0016]
+ *
+ * Producto de dos formas afines reducidas (modelo AF_fAF2)
+ *     x = x0 + sum_i a_i e_i + ex xi,     y = y0 + sum_i b_i e_i + ey eta,
+ *     x y = x0 y0 + sum_i (x0 b_i + y0 a_i) e_i + N(e, xi, eta),
+ *     N = x0 ey eta + y0 ex xi + (a^T e + ex xi)(b^T e + ey eta).
+ * Este archivo calcula un intervalo que encierra el rango de N sobre [-1,1]^(n+2):
+ *
+ *   raf_mult_enclosure(..., exact = false): Skalna y Hladik (Numer. Algor. 76, 2017, Ec. 10):
+ *       rango exacto de R = (a^T e + ex xi)(b^T e + ey eta)  +  [-1,1] (|y0| ex + |x0| ey).
+ *   raf_mult_enclosure(..., exact = true): rango exacto de N (paper "Exact multiplication of
+ *       reduced affine forms", Algoritmo 1): N es afin en xi y en eta, asi que sus extremos estan
+ *       con (xi, eta) en {-1,1}^2; para cada esquina, N es un producto desplazado
+ *       (u + ex s)(v + ey t) de (u, v) = (a^T e, b^T e) en el zonotopo plano de generadores
+ *       (a_i, b_i), cuyos extremos estan en el borde (el unico punto critico es una silla).
+ *
+ * Rigor:
+ *   - Los generadores se orientan al semiplano {u > 0} U {u = 0, v > 0} (cambio de signo exacto)
+ *     y se ordenan por angulo con un predicado exacto: u1 v2 - v1 u2 se evalua en __float128,
+ *     donde el producto de dos double es exacto (106 bits <= 113) y la resta, correctamente
+ *     redondeada, conserva el signo. Un orden erroneo podria hacer que el recorrido entrara al
+ *     interior del zonotopo y subestimara el rango.
+ *   - Los vertices del poligono y los valores en las aristas se calculan con ibex::Interval
+ *     (redondeo hacia afuera). En cada arista [p, q], phi(p + tau d) = P + B tau + A tau^2 con
+ *     P = pu pv, B = pu dv + pv du, A = du dv; se incluyen phi(p), phi(q) y, si A no contiene 0 y
+ *     tau* = -B/(2A) corta (0,1), el valor estacionario P - B^2/(4A); si A contiene 0, la
+ *     extension de Horner P + tau (B + A tau) con tau = [0,1].
+ *   - El intervalo devuelto contiene el rango exacto de N; el llamador suma su centro y radio
+ *     con las mismas reglas de redondeo de fAF2.
+ * ---------------------------------------------------------------------------- */
+#ifndef __IBEX_EXACT_MULT_H__
+#define __IBEX_EXACT_MULT_H__
+
+#include "ibex_Interval.h"
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace ibex {
+
+/** Contadores de los modos AFFINE_SH y AFFINE_EXACT (por hilo). */
+struct ExactMultStats {
+	long products = 0;        // productos de formas activas con AFFINE_SH o AFFINE_EXACT
+	long with_errors = 0;     // ... con ex > 0 y ey > 0
+	long coupled = 0;         // ... con min(|x0| ey, |y0| ex) > 0: los unicos en que E puede ganar a SH
+	long exact_walks = 0;     // productos en que AFFINE_EXACT hizo las cuatro vueltas
+};
+
+inline ExactMultStats& exact_mult_stats() {
+	static thread_local ExactMultStats s;
+	return s;
+}
+
+namespace exact_mult_detail {
+
+struct Gen { double u, v; };
+
+/** true si g1 precede a g2 en orden angular (ambos en el semiplano u > 0 o u = 0, v > 0). */
+inline bool angle_less(const Gen& g1, const Gen& g2) {
+	const __float128 c = (__float128) g1.u * (__float128) g2.v - (__float128) g1.v * (__float128) g2.u;
+	return c > 0;
+}
+
+/** Generadores no nulos, orientados y ordenados por angulo (orden exacto). */
+inline std::vector<Gen> sorted_generators(const std::vector<Gen>& in) {
+	std::vector<Gen> g;
+	g.reserve(in.size());
+	for (const Gen& x : in) {
+		if (x.u == 0.0 && x.v == 0.0) continue;
+		if (x.u < 0.0 || (x.u == 0.0 && x.v < 0.0)) g.push_back(Gen{-x.u, -x.v});
+		else g.push_back(x);
+	}
+	std::stable_sort(g.begin(), g.end(), angle_less);
+	return g;
+}
+
+/** Encierro riguroso del rango de (u + c0)(v + c1) sobre el zonotopo de los generadores g (ya ordenados). */
+inline Interval shifted_product_range(const std::vector<Gen>& g, const Interval& c0, const Interval& c1) {
+	if (g.empty()) return c0 * c1;
+	Interval pu = c0, pv = c1;
+	for (const Gen& x : g) { pu -= x.u; pv -= x.v; }
+	Interval res = pu * pv;
+	for (int sgn = 0; sgn < 2; sgn++) {
+		const double f = (sgn == 0) ? 2.0 : -2.0;
+		for (const Gen& x : g) {
+			const double du = f * x.u, dv = f * x.v;           // exactos (multiplicacion por potencia de 2)
+			const Interval qu = pu + du, qv = pv + dv;
+			res |= qu * qv;
+			const Interval A = Interval(du) * dv;
+			const Interval B = pu * dv + pv * du;
+			if (!A.contains(0.0)) {
+				const Interval tau = -B / (2.0 * A);
+				if (tau.ub() > 0.0 && tau.lb() < 1.0)
+					res |= pu * pv - sqr(B) / (4.0 * A);
+			} else {
+				const Interval t01(0.0, 1.0);
+				res |= pu * pv + t01 * (B + A * t01);
+			}
+			pu = qu;
+			pv = qv;
+		}
+	}
+	return res;
+}
+
+} // namespace exact_mult_detail
+
+/**
+ * Encierro del rango de N (ver arriba). a, b: coeficientes de ruido de x e y (mismo largo);
+ * x0, y0: centros; ex, ey: errores (>= 0). exact = false: Skalna-Hladik; true: rango exacto de N.
+ */
+inline Interval raf_mult_enclosure(const std::vector<double>& a, const std::vector<double>& b,
+                                   double x0, double ex, double y0, double ey, bool exact) {
+	using namespace exact_mult_detail;
+	const size_t n = std::min(a.size(), b.size());
+	std::vector<Gen> gens;
+	gens.reserve(n + 2);
+	for (size_t i = 0; i < n; i++) gens.push_back(Gen{a[i], b[i]});
+
+	ExactMultStats& st = exact_mult_stats();
+	st.products++;
+	if (ex > 0.0 && ey > 0.0) st.with_errors++;
+	const bool coupled = (std::fabs(x0) * ey > 0.0) && (std::fabs(y0) * ex > 0.0);
+	if (coupled) st.coupled++;
+
+	if (!exact || !coupled) {
+		// Skalna-Hladik; con exact y min(|x0| ey, |y0| ex) = 0 coincide con E (Corolario 11).
+		gens.push_back(Gen{ex, 0.0});
+		gens.push_back(Gen{0.0, ey});
+		const Interval R = shifted_product_range(sorted_generators(gens), Interval(0.0), Interval(0.0));
+		const Interval lin = Interval(std::fabs(y0)) * ex + Interval(std::fabs(x0)) * ey;
+		return R + Interval(-lin.ub(), lin.ub());
+	}
+
+	st.exact_walks++;
+	const std::vector<Gen> g = sorted_generators(gens);   // una sola vez para las cuatro esquinas
+	Interval res = Interval::empty_set();
+	for (int s = -1; s <= 1; s += 2)
+		for (int t = -1; t <= 1; t += 2) {
+			const Interval kappa = Interval(x0) * (ey * t) + Interval(y0) * (ex * s);
+			res |= kappa + shifted_product_range(g, Interval(ex * s), Interval(ey * t));
+		}
+	return res;
+}
+
+} // namespace ibex
+
+#endif // __IBEX_EXACT_MULT_H__
